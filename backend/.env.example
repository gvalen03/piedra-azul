PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=piedra_azul_test

# Local login is for isolated development only. Production must use keycloak.
AUTH_PROVIDER=local
JWT_SECRET=replace-with-a-random-local-secret
JWT_EXPIRES_IN=8h

# For AUTH_PROVIDER=keycloak, set these and apply migration 008.
# AUTH_PROVIDER=keycloak
# KEYCLOAK_ISSUER=http://localhost:8081/realms/piedra-azul
# KEYCLOAK_AUDIENCE=piedra-azul-api
# KEYCLOAK_CLIENT_ID=piedra-azul-api
# KEYCLOAK_JWKS_URI=http://localhost:8081/realms/piedra-azul/protocol/openid-connect/certs
# Confidential service client. Keep its secret outside version control.
# KEYCLOAK_PROVISIONER_CLIENT_ID=piedra-azul-provisioner
# KEYCLOAK_PROVISIONER_CLIENT_SECRET=
