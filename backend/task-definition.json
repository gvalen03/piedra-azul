{
  "family": "piedra-azul-backend",
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "piedra-azul-backend",
      "image": "000000000000.dkr.ecr.us-east-1.localhost:4566/piedra-azul-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DB_HOST",
          "value": "host.docker.internal"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_USER",
          "value": "valen"
        },
        {
          "name": "DB_PASSWORD",
          "value": ""
        },
        {
          "name": "DB_NAME",
          "value": "piedra_azul"
        }
      ]
    }
  ]
}