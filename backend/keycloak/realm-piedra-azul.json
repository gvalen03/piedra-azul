{
  "realm": "piedra-azul",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "roles": {
    "realm": [
      { "name": "ADMINISTRADOR", "description": "Administración de Piedra Azul" },
      { "name": "AGENDADOR", "description": "Gestión de agenda de Piedra Azul" },
      { "name": "MEDICO_TERAPISTA", "description": "Atención médica de Piedra Azul" },
      { "name": "PACIENTE", "description": "Acceso de paciente a Piedra Azul" }
    ]
  },
  "clientScopes": [
    {
      "name": "piedra-azul-api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "piedra-azul-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "piedra-azul-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "piedra-azul-api",
      "name": "Piedra Azul public SPA/API client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5555/callback",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5555"
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email",
        "piedra-azul-api-audience"
      ],
      "protocolMappers": [
        {
          "name": "Piedra Azul subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "Piedra Azul realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "piedra-azul-provisioner",
      "name": "Piedra Azul Postman development provisioner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false
    }
  ]
}
